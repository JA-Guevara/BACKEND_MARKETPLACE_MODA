APP_NAME=FashionStore API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fashionstore
JWT_SECRET_KEY=change-this-secret-with-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=["http://localhost:4200"]
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@fashionstore.local
SMTP_USE_TLS=true

# Comercio: exclusivamente Stripe TEST; claves privadas solo en backend
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_CURRENCY=bob
# IA opcional: no se envian datos personales, solo metricas agregadas
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
MEDIA_STORAGE_DIR=uploads/images
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/api/v1/media/files
MEDIA_MAX_UPLOAD_MB=5
