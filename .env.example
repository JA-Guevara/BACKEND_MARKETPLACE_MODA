# ============================================================
# FashionStore API — plantilla de entorno
# Copiá este archivo como `.env` y completá tus valores.
#   cp .env.example .env   (Windows: copy .env.example .env)
# ------------------------------------------------------------
# Identidad
APP_NAME=FashionStore API
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55435/desarrollo_local
# Solo Railway/operaciones remotas autorizadas: ALLOW_REMOTE_DB=1.
# No habilitar esta excepción en el .env de desarrollo.
# Host directo canónico de producción, obligatorio en staging; nunca una URL.
PRODUCTION_DB_HOST=
# Tokens de servicio; configurar mediante secretos, nunca en Git.
BACKUP_REPORT_TOKEN=
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
# Mantenimiento bloquea escrituras de empresa; permite operación de plataforma.
MODO_MANTENIMIENTO=false
# Controles de seguridad/observabilidad (PS1.1/PS1.2).
RATE_LIMIT_ENABLED=true
SENTRY_DSN=
# MFA (PS2.1): clave cifrada por el operador; no activar antes de integrar clientes.
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_PLATFORM=true
# Almacenamiento: usar volumen fuera del código o configurar S3 en PS2.5.
MEDIA_BACKEND=local

# Seguridad / JWT
JWT_SECRET_KEY=cambia-por-una-cadena-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Frontend y CORS
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=["http://localhost:4200"]

# Correo (SMTP). Sin esto no salen los enlaces de verificación ni de recuperación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=tu-contrasena-de-app
SMTP_FROM_EMAIL=tu-correo@gmail.com
SMTP_USE_TLS=true

# Casilla que recibe avisos de reserva cuando la sucursal no tiene correo (RF11)
OPERATIONS_EMAIL=

# Pagos (Stripe / BOB)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_BILLING_WEBHOOK_SECRET=whsec_configurar_destino_de_planes
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_configurar_destino_de_cuentas_conectadas
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_TEST_COUNTRY=US
COMMERCE_CURRENCY=bob

# Asistente de IA (opcional)
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
AI_TRANSCRIPTION_MODEL=gemini-3.8-flash
AI_TIMEOUT=30
AI_MAX_TOKENS=600

# Reportes y stock
REPORT_EXPORT_MAX_ROWS=10000
LOW_STOCK_THRESHOLD=5

# Archivos (imágenes de prendas)
MEDIA_STORAGE_DIR=uploads/images
MEDIA_PUBLIC_BASE_URL=http://localhost:8000/api/v1/media/files
MEDIA_MAX_UPLOAD_MB=5

# Foto IA realista del probador (Fase 3)
#  TRYON_PROVIDER: none (sin servicio), mock (composición local para desarrollo
#                  y pruebas) o fashn (proveedor real, exige TRYON_API_KEY).
# En producción dejalo en none hasta contar con una clave FASHN válida.
TRYON_PROVIDER=none
TRYON_API_KEY=
TRYON_MAX_ACTIVE_JOBS=3
TRYON_RESULT_EXPIRATION_HOURS=48
